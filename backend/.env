# -----------------------------------------------------------------------------
# AM I COOKED? — Backend environment
# Copy this file to `.env` and fill in only what you want to use.
# The backend works with ZERO configuration — it will use the MockProvider.
# -----------------------------------------------------------------------------

# Provider: mock | openai | groq
# Default is `mock` — no API key needed, deterministic sample responses.
AI_PROVIDER=mock

# Optional: OpenAI
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: Groq (fast + free tier)
# AI_PROVIDER=groq
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.1-70b-versatile
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Request timeout in seconds (per AI call)
AI_TIMEOUT_SECONDS=25

# CORS origins allowed in development (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173